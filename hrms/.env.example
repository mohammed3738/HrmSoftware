# HRMS settings template. Copy to hrms/.env and fill in the values:
#     cp .env.example .env
# hrms/settings.py reads .env at start-up. Every variable is optional:
# without a .env the app runs in local-development mode (SQLite, DEBUG on).
# Never commit the real .env -- it is git-ignored.

# --- Django -----------------------------------------------------------------
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Changing it later logs every user out.
DJANGO_SECRET_KEY=change-me

# Must be false on a server: true shows full error pages, code and settings.
DJANGO_DEBUG=false

# Domains the app answers to, comma-separated.
DJANGO_ALLOWED_HOSTS=hrms.zacoinfotech.com,127.0.0.1,localhost

# HTTPS origins allowed to submit forms (needed for login behind nginx/HTTPS).
DJANGO_CSRF_TRUSTED_ORIGINS=https://hrms.zacoinfotech.com

# true = login cookies only over HTTPS. Set false only for a plain-HTTP test setup.
DJANGO_SECURE_COOKIES=true

# --- Database ---------------------------------------------------------------
# postgres on the server; sqlite (or leave unset) for local development.
DB_ENGINE=postgres
DB_NAME=hrms_prod_db
DB_USER=hrms_prod_user
# Generate one with: openssl rand -hex 24
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Only used when DB_ENGINE=sqlite. Defaults to hrms/db.sqlite3.
# SQLITE_PATH=/path/to/db.sqlite3

# --- Redis ------------------------------------------------------------------
# Redis is shared with other projects on the server: give this project its own
# database numbers (0-15) so other Celery workers never pick up its tasks.
CELERY_BROKER_URL=redis://127.0.0.1:6379/10
REDIS_CACHE_URL=redis://127.0.0.1:6379/11

# --- Nightly backup by email (scripts/email_backup.py) ------------------------
# The backup is emailed and then deleted -- nothing is kept on the server.
# Gmail: smtp.gmail.com / 587, BACKUP_EMAIL_USER = the Gmail address and
# BACKUP_EMAIL_PASSWORD = a 16-character App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords), not the normal password.
BACKUP_EMAIL_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = SSL.
BACKUP_EMAIL_PORT=587
BACKUP_EMAIL_USER=change-me@gmail.com
BACKUP_EMAIL_PASSWORD=change-me
# Sender address shown in the email (defaults to BACKUP_EMAIL_USER).
BACKUP_EMAIL_FROM=change-me@gmail.com
# Who receives the backups; several addresses separated by commas.
BACKUP_EMAIL_TO=change-me@gmail.com
# Attachment budget in MB. 18 keeps the email under Gmail's 25 MB limit.
BACKUP_EMAIL_MAX_MB=18
# Used in the email subject and file names.
BACKUP_NAME=hrms_prod
