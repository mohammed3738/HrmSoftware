# HRMS settings template. Copy to hrms/.env and fill in the values:
#     cp .env.example .env
# hrms/settings.py reads .env at start-up. Every variable is optional:
# without a .env the app runs in local-development mode (SQLite, DEBUG on).
# Never commit the real .env -- it is git-ignored.

# --- Django -----------------------------------------------------------------
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Changing it later logs every user out.
DJANGO_SECRET_KEY=change-me

# Must be false on a server: true shows full error pages, code and settings.
DJANGO_DEBUG=false

# Domains the app answers to, comma-separated.
DJANGO_ALLOWED_HOSTS=hrms.zacoinfotech.com,127.0.0.1,localhost

# HTTPS origins allowed to submit forms (needed for login behind nginx/HTTPS).
DJANGO_CSRF_TRUSTED_ORIGINS=https://hrms.zacoinfotech.com

# true = login cookies only over HTTPS. Set false only for a plain-HTTP test setup.
DJANGO_SECURE_COOKIES=true

# --- Database ---------------------------------------------------------------
# Which backend to use:
#     postgres   (also: postgresql, psql, pg)   what a server uses
#     sqlite     (also: sqlite3, or leave unset) what a development PC uses
#
# ON A DEVELOPMENT MACHINE, SET THIS TO sqlite AND IGNORE THE REST OF THIS
# SECTION. The values below are a server's: copying them onto a PC points it
# at a database called hrms_prod_db with the password still set to
# "change-me", which cannot work. DB_ENGINE=sqlite needs nothing installed
# and keeps the database in a single file at hrms/db.sqlite3.
DB_ENGINE=postgres

# Only read when DB_ENGINE=postgres. All three are required; start-up stops
# with a message naming whichever one is missing or still says "change-me".
DB_NAME=hrms_prod_db
DB_USER=hrms_prod_user
# Generate one with: openssl rand -hex 24
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Only used when DB_ENGINE=sqlite. Defaults to hrms/db.sqlite3. A relative
# path is taken from the hrms/ folder, so the database does not move
# depending on where manage.py was run from.
# SQLITE_PATH=/path/to/db.sqlite3

# --- Redis ------------------------------------------------------------------
# Redis is shared with other projects on the server: give this project its own
# database numbers (0-15) so other Celery workers never pick up its tasks.
CELERY_BROKER_URL=redis://127.0.0.1:6379/10
REDIS_CACHE_URL=redis://127.0.0.1:6379/11

# --- Nightly backup by email (scripts/email_backup.py) ------------------------
# The backup is emailed and then deleted -- nothing is kept on the server.
# Gmail: smtp.gmail.com / 587, BACKUP_EMAIL_USER = the Gmail address and
# BACKUP_EMAIL_PASSWORD = a 16-character App Password (Google Account ->
# Security -> 2-Step Verification -> App passwords), not the normal password.
BACKUP_EMAIL_HOST=smtp.gmail.com
# 587 = STARTTLS, 465 = SSL.
BACKUP_EMAIL_PORT=587
BACKUP_EMAIL_USER=change-me@gmail.com
BACKUP_EMAIL_PASSWORD=change-me
# Sender address shown in the email (defaults to BACKUP_EMAIL_USER).
BACKUP_EMAIL_FROM=change-me@gmail.com
# Who receives the backups; several addresses separated by commas.
BACKUP_EMAIL_TO=change-me@gmail.com
# Attachment budget in MB. 18 keeps the email under Gmail's 25 MB limit.
BACKUP_EMAIL_MAX_MB=18
# Used in the email subject and file names.
BACKUP_NAME=hrms_prod

# --- Biometric (eSSL / eTimeTrackLite) attendance sync -----------------------
# The punch machine's SQL Server is on another network with no route to this
# server, so an agent on that Windows box pushes punches to
# /api/biometric/punches/ instead. Full walkthrough:
# ESSL_INTEGRATION_GUIDE.txt in the repository root.

# Shared secret the agent sends in the X-HRMS-Sync-Token header. The same
# string goes in essl_agent.ini on the Windows server. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving it empty switches the punch endpoint off entirely.
BIOMETRIC_SYNC_TOKEN=change-me

# How far back each run re-reads and rebuilds. Must be at least 2 so a night
# shift's second half (the next day's first punch) is always in the window.
BIOMETRIC_SYNC_LOOKBACK_DAYS=3

# Hours (local time, 24h) the scheduled sync runs at. The default is every
# second hour from 10:00 through midnight -- midnight included on purpose,
# because that run is what closes the previous night shift.
BIOMETRIC_SYNC_HOURS=10,12,14,16,18,20,22,0

# A span longer than this is a missed out-punch, not a shift: the out-time is
# left blank rather than crediting an absurd day.
BIOMETRIC_MAX_SHIFT_HOURS=16

# Night-shift guard rails. A night employee's in-time is the day's LAST punch,
# but only from BIOMETRIC_NIGHT_IN_FROM onwards -- somebody who only punched
# at 06:00 was punching OUT of the previous night. Likewise the next day's
# first punch counts as their out-punch only before BIOMETRIC_NIGHT_OUT_UNTIL.
BIOMETRIC_NIGHT_IN_FROM=12:00
BIOMETRIC_NIGHT_OUT_UNTIL=12:00

# A punch dated further ahead than this many days is rejected: a punch in the
# future means a device's clock is wrong, not that somebody worked. One day of
# tolerance covers clock skew and a reader running an hour or two ahead.
BIOMETRIC_FUTURE_PUNCH_TOLERANCE_DAYS=1

# --- Shift Roster tidy-up ----------------------------------------------------
# Days after a rotation ends before it leaves the ACTIVE Shift Roster (it moves
# to the Archived filter; nothing is deleted). Attendance for those dates is
# unaffected: the biometric sync keeps honouring auto-archived entries when
# recalculating them. Keep this comfortably above
# BIOMETRIC_SYNC_LOOKBACK_DAYS, so a rotation that only just finished stays
# visible while the sync is still re-reading those days.
SHIFT_ROSTER_ARCHIVE_AFTER_DAYS=7

# Optional direct-pull mode, for a machine that can actually reach the eSSL
# SQL Server (a development PC on the same LAN). Needs pyodbc plus an ODBC
# driver; leave unset on the Ubuntu server, which has no route to it.
# BIOMETRIC_MSSQL_HOST=192.168.1.135\SQLEXPRESS
# BIOMETRIC_MSSQL_DATABASE=etimetracklite1
# BIOMETRIC_MSSQL_USER=hrms_reader
# BIOMETRIC_MSSQL_PASSWORD=change-me
# BIOMETRIC_MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# BIOMETRIC_MSSQL_TRUSTED_CONNECTION=false
